{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gojek-clone-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // replace with `wrangler hyperdrive create gojek --connection-string=... --caching-disabled` output
      "id": "00000000000000000000000000000000",
      // `pnpm db:up` (docker compose); override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
      "localConnectionString": "postgres://postgres:postgres@localhost:54329/gojek"
    }
  ],
  // each zone has two actors: match:<zone> (free drivers, search) and ride:<zone> (its rides, drivers on a trip)
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "MatchDO" },
      { "name": "RIDE", "class_name": "RideDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ZoneDO"] },
    // ZoneDO split in two; never deployed with data that matters
    { "tag": "v2", "new_sqlite_classes": ["MatchDO", "RideDO"], "deleted_classes": ["ZoneDO"] }
  ],
  "ratelimits": [
    // per client IP
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // per user: WebSocket (re)connects
    { "name": "WS_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Every var below is validated (types, ranges, defaults) in src/env.ts; a bad value fails the request loudly.
  "vars": {
    // "*" or a comma-separated list of origins allowed to call the API (the simulators' URLs in production)
    "CORS_ORIGINS": "*",
    // Durable Object placement near the Postgres region (wnam, enam, sam, weur, eeur, apac, oc, afr, me);
    // empty = nearest to the first request. Only affects zone actors created after it is set.
    "DO_LOCATION_HINT": "apac",
    // geohash length of one zone actor (<= 5 so a zone always covers whole search cells)
    "ZONE_PRECISION": "5",
    // ride actors per zone: "1" (no sharding), "4" (every zone), or "qqguw=8,qqgux=4,*=1" (busy zones only).
    // Raising or lowering it is safe at any time: a ride stays in the shard its id names.
    "RIDE_SHARDS": "1",
    "COMMISSION_RATE": "0.2",
    "DRIVER_MIN_BALANCE": "-50000",
    "OFFER_TIMEOUT_MS": "15000",
    "RESERVE_TTL_MS": "20000",
    "SEARCH_TIMEOUT_MS": "120000",
    "RESEARCH_DELAY_MS": "5000",
    "TOPUP_MAX": "1000000",
    // a ride its drivers dropped this many times is searched again no more: the system cancels it
    "MAX_REQUEUES": "3",
    // ON_TRIP driver without a location ping: ask the customer every hour, cancel by system after 3 hours
    "DRIVER_LOST_ASK_MS": "3600000",
    "DRIVER_LOST_CANCEL_MS": "10800000",
    // ON_TRIP route: points buffered in the zone actor are sent to Postgres (ride_track) this often
    "TRACK_FLUSH_MS": "60000",
    // ON_TRIP route thinning: a point every TRACK_MIN_GAP_M (or TRACK_MAX_GAP_MS), and wherever the stored line
    // would stray more than TRACK_TOLERANCE_M from the driver's pings (turns, curves)
    "TRACK_MIN_GAP_M": "200",
    "TRACK_MAX_GAP_MS": "60000",
    "TRACK_TOLERANCE_M": "25",
    // location throttle: the server drops a ping that came sooner than this after the last kept one AND
    // moved < LOC_MIN_MOVE_M. Not on a ride it is the heartbeat of a driver standing still (below the
    // client's 10 s idle ping, and well inside the matcher's 30 s staleness). Then zone hand-over hysteresis.
    "LOC_MIN_INTERVAL_MS": "8000",
    "LOC_MIN_INTERVAL_ON_RIDE_MS": "1000",
    "LOC_MIN_MOVE_M": "30",
    "HANDOFF_MARGIN_M": "100",
    "HANDOFF_PINGS": "3",
    // a driver must be this close (m, straight line) to the pickup to arrive and to the dropoff to complete:
    // no paid trip from a driver who never moved. Generous enough for GPS drift and a pin across the street.
    "ARRIVE_MAX_DISTANCE_M": "200",
    "COMPLETE_MAX_DISTANCE_M": "300"
  }
  // JWT_SECRET: `wrangler secret put JWT_SECRET` (local: .dev.vars)
}
