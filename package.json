{
  "name": "gojek-clone",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev": "turbo run dev --filter=@gojek/api --filter=@gojek/simulator-customer --filter=@gojek/simulator-driver",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter @gojek/e2e e2e",
    "demo:live": "pnpm --filter @gojek/e2e demo:live",
    "demo:record": "pnpm --filter @gojek/e2e demo:record"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
